# Yo Champs stores configuration in
#   ~/Library/Application Support/YoChamps/config.json
# and API keys in the macOS Keychain (service com.yurioliveira.yochamps).
#
# This file documents optional environment overrides for local development.
# Copy to .env only if you need them; never commit .env or real values.
# The app does not read these yet: they are reserved for the M2 provider work.
#
# Provider base URL, e.g. https://openrouter.ai/api/v1
YOCHAMPS_PROVIDER_BASE_URL=
# Model id, e.g. an OpenAI-compatible model name
YOCHAMPS_PROVIDER_MODEL=
# API key: prefer the Keychain; env is a dev-only convenience
YOCHAMPS_PROVIDER_KEY=
# Log level: debug, info, notice, error
YOCHAMPS_LOG_LEVEL=
